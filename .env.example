# Copy to .env and adjust. Every value is optional unless marked REQUIRED; the
# platform degrades gracefully (heuristic fallbacks, public endpoints) when a
# provider key is missing. Lists accept JSON or comma-separated values.

# ------------------------------------------------------------------ app
APP_NAME="Quantachain Backend"
ENVIRONMENT=development            # development | test | staging | production
DEBUG=false
LOG_LEVEL=INFO
# LOG_JSON=true                    # default: JSON in production, pretty console elsewhere
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8000     # used for OAuth callback URLs
FRONTEND_URL=http://localhost:3000        # OAuth redirect target (…/auth/callback#access_token=…)
DOCS_ENABLED=true

# ------------------------------------------------------------- database
MONGODB_URI=mongodb://localhost:27017     # REQUIRED (Atlas URIs work too)
MONGODB_DB=quantachain
MONGODB_TICK_TTL_DAYS=30

# ------------------------------------------------------------- security
SECRET_KEY=change-me-to-a-long-random-string          # REQUIRED in production
# ENCRYPTION_KEY=                     # Fernet key for user secrets; derived from SECRET_KEY if unset
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
MFA_ISSUER=Quantachain
RATE_LIMIT_PER_MINUTE=240
# FIRST_ADMIN_EMAIL=you@example.com   # this email becomes admin on registration
#                                      # (in development the very first user is also promoted)

# ---------------------------------------------------------------- oauth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# -------------------------------------------------------------- workers
WORKERS_ENABLED=true               # the dedicated worker process (python -m app.worker)
RUN_WORKERS_IN_API=false           # true = single-process dev mode
BACKFILL_ON_START=true
TRACKED_SYMBOLS=BTC,ETH,SOL,BNB,XRP,ADA,DOGE,AVAX,LINK,DOT
QUOTE_ASSET=USDT

# ---------------------------------------------------- market data (M2)
BINANCE_WS_ENABLED=true
COINGECKO_POLL_SECONDS=120
# COINGECKO_API_KEY=                # demo key raises rate limits
# NEWSAPI_KEY=                      # https://newsapi.org (RSS feeds work without it)
NEWS_POLL_SECONDS=300
REDDIT_ENABLED=true
SOCIAL_POLL_SECONDS=300

# ------------------------------------------------------- on-chain (M3)
# ALCHEMY_API_KEY=                  # primary RPC
# INFURA_API_KEY=                   # automatic fallback
# EVM_RPC_URLS=                     # extra JSON-RPC fallbacks (comma separated)
# MORALIS_API_KEY=                  # wallet/token enrichment + streams
# MORALIS_STREAM_SECRET=            # verifies POST /onchain/webhooks/moralis
# ETHERSCAN_API_KEY=                # verified contract source for the scanner
ONCHAIN_POLL_SECONDS=15
WHALE_THRESHOLD_USD=1000000
WHALE_ALERT_THRESHOLD_USD=10000000

# ------------------------------------------------------ sentiment (M4)
# OPENAI_API_KEY=                   # GPT-4o scoring; heuristic analyzer used when absent
OPENAI_MODEL=gpt-4o
SENTIMENT_BATCH_SIZE=20
SENTIMENT_POLL_SECONDS=120

# ----------------------------------------------------- prediction (M5)
DATA_DIR=var                        # ML models and generated reports
PREDICTION_REFRESH_SECONDS=900
PREDICTION_HORIZONS=1h,4h,24h
LSTM_ENABLED=true                   # used when TensorFlow (requirements-ml.txt) is installed
SIGNAL_SIGMA_THRESHOLD=1.5

# ---------------------------------------------------------- fraud (M6)
FRAUD_POLL_SECONDS=120
RUG_PULL_LIQUIDITY_DROP_PCT=50
PUMP_PRICE_SPIKE_PCT=40

# -------------------------------------------------------- notifications
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_JSON=          # JSON text or a path to the service-account file
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=alerts@quantachain.local
# ADMIN_ALERT_EMAILS=admin@example.com
ERROR_ALERT_THRESHOLD=5
ERROR_ALERT_WINDOW_SECONDS=300

# -------------------------------------------------------- trading (M9)
LIVE_TRADING_ENABLED=false          # global kill switch; paper trading is always available
PAPER_STARTING_BALANCE=100000
PAPER_FEE_RATE=0.001
DEFAULT_EXCHANGE=binance
